{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node", "bun", "vite/client"],
        "paths": {
            "outpost-workflows": ["../outpost/workflows/index.ts"],
            "@bench/*": ["./bench/*"],
            "@site/*": ["./src/*"],
            "@results/*": ["./results/*"]
        }
    },
    "include": ["bench", "src", "vite.config.ts"]
}
